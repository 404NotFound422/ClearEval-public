{
  "type": "object",
  "properties": {
    "extraction": {
      "$ref": "#/$defs/extraction"
    },
    "assessment": {
      "$ref": "#/$defs/assessment"
    },
    "objectives": {
      "type": "object"
    },
    "method_declarations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/methodDeclaration"
      }
    }
  },
  "required": [
    "extraction",
    "assessment",
    "objectives"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OEQ canonical record-reference output contract",
  "description": "Canonical record-reference output syntax and types only. Existing source, field, scope, coverage and scientific validators remain authoritative.",
  "$defs": {
    "originalSpan": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "quote": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "quote"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 1
            },
            "quote": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "start",
            "end",
            "quote"
          ],
          "additionalProperties": false
        }
      ]
    },
    "fieldSupport": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "EXPLICIT",
            "DERIVED",
            "INFERRED",
            "MISSING"
          ]
        },
        "raw_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "transform": {
          "type": "string"
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/originalSpan"
          }
        }
      },
      "required": [
        "kind",
        "spans"
      ],
      "additionalProperties": true,
      "anyOf": [
        {
          "properties": {
            "kind": {
              "const": "EXPLICIT"
            },
            "raw_value": {
              "type": "string",
              "minLength": 1
            },
            "transform": {
              "const": "IDENTITY"
            }
          },
          "required": [
            "raw_value",
            "transform"
          ]
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "DERIVED",
                "INFERRED",
                "MISSING"
              ]
            }
          }
        }
      ]
    },
    "assertion": {
      "type": "object",
      "properties": {
        "polarity": {
          "type": "string",
          "enum": [
            "AFFIRMED",
            "NEGATED",
            "CONDITIONAL"
          ]
        }
      },
      "required": [
        "polarity"
      ],
      "additionalProperties": true
    },
    "branch": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "SERIAL",
            "ALTERNATIVE"
          ]
        },
        "sample_id": {
          "type": "string",
          "minLength": 1
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/originalSpan"
          }
        }
      },
      "required": [
        "id",
        "mode",
        "sample_id",
        "spans"
      ],
      "additionalProperties": true
    },
    "stepReference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "record_id",
        "branch"
      ],
      "additionalProperties": false
    },
    "labelSupports": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/$defs/fieldSupport"
        },
        "probe": {
          "$ref": "#/$defs/fieldSupport"
        },
        "fluorophore": {
          "$ref": "#/$defs/fieldSupport"
        },
        "channel": {
          "$ref": "#/$defs/fieldSupport"
        }
      },
      "required": [
        "target",
        "probe",
        "fluorophore",
        "channel"
      ],
      "additionalProperties": false
    },
    "riSupports": {
      "type": "object",
      "properties": {
        "solution": {
          "$ref": "#/$defs/strictRIFieldSupport"
        },
        "value_text": {
          "$ref": "#/$defs/strictRIFieldSupport"
        }
      },
      "required": [
        "solution",
        "value_text"
      ],
      "additionalProperties": false
    },
    "label": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "probe": {
          "type": [
            "string",
            "null"
          ]
        },
        "fluorophore": {
          "type": [
            "string",
            "null"
          ]
        },
        "channel": {
          "type": [
            "string",
            "null"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "field_support": {
          "$ref": "#/$defs/labelSupports"
        },
        "assertion": {
          "$ref": "#/$defs/assertion"
        }
      },
      "required": [
        "id",
        "branch",
        "target",
        "probe",
        "fluorophore",
        "channel",
        "quote",
        "field_support",
        "assertion"
      ],
      "additionalProperties": false
    },
    "ri": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "solution": {
          "type": [
            "string",
            "null"
          ]
        },
        "value_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "field_support": {
          "$ref": "#/$defs/riSupports"
        },
        "assertion": {
          "$ref": "#/$defs/assertion"
        }
      },
      "required": [
        "branch",
        "solution",
        "value_text",
        "quote",
        "field_support",
        "assertion"
      ],
      "additionalProperties": false
    },
    "extraction": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "extraction-record-refs-v1"
        },
        "protocol_sha256": {
          "type": "string",
          "minLength": 1
        },
        "branches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/branch"
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/label"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stepReference"
          }
        },
        "ri": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ri"
          }
        },
        "limitations": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "protocol_sha256",
        "branches",
        "labels",
        "steps",
        "ri",
        "limitations"
      ],
      "additionalProperties": false
    },
    "evidenceCheck": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string"
        },
        "passage_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claim": {
          "type": "string"
        },
        "relation": {
          "type": "string",
          "enum": [
            "SUPPORTS",
            "REFUTES",
            "NOINFO"
          ]
        },
        "applicability": {
          "type": "object"
        },
        "protocol_bindings": {
          "type": "object"
        },
        "verification_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "requirementAssessment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "SATISFIED",
            "VIOLATED",
            "UNDER_SPECIFIED",
            "UNRESOLVED"
          ]
        },
        "basis": {
          "type": "string",
          "enum": [
            "PROTOCOL_TEXT",
            "SUPPLIED_EVIDENCE",
            "MODEL_KNOWLEDGE",
            "MISSING"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceCheck"
          }
        }
      },
      "required": [
        "id",
        "status",
        "basis",
        "evidence_ids",
        "quotes",
        "reason",
        "evidence_checks"
      ],
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "judgment-grounding-v2"
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirementAssessment"
          }
        },
        "limitations": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "requirements",
        "limitations"
      ],
      "additionalProperties": false
    },
    "methodDeclaration": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "span": {
          "$ref": "#/$defs/originalSpan"
        }
      },
      "required": [
        "name",
        "branch",
        "span"
      ],
      "additionalProperties": false
    },
    "originalOffsetSpan": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "start",
        "end",
        "quote"
      ],
      "additionalProperties": false
    },
    "strictRIFieldSupport": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "EXPLICIT",
            "DERIVED",
            "INFERRED",
            "MISSING"
          ]
        },
        "raw_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "transform": {
          "type": "string"
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/originalOffsetSpan"
          }
        }
      },
      "required": [
        "kind",
        "spans"
      ],
      "additionalProperties": true,
      "anyOf": [
        {
          "properties": {
            "kind": {
              "const": "EXPLICIT"
            },
            "raw_value": {
              "type": "string",
              "minLength": 1
            },
            "transform": {
              "const": "IDENTITY"
            }
          },
          "required": [
            "raw_value",
            "transform"
          ]
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "DERIVED",
                "INFERRED",
                "MISSING"
              ]
            }
          }
        }
      ]
    }
  }
}
