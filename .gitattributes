/dataset/Q+AR/src/question_final.json -text whitespace=cr-at-eol
/dataset/Q+AR/src/restrict.py -text whitespace=cr-at-eol
/dataset/Q+AR/revisions/2026-09-13-stem-fixes/before/question_final.json -text whitespace=cr-at-eol
/dataset/Q+AR/revisions/2026-09-13-stem-fixes/before/restrict.py -text whitespace=cr-at-eol

# Frozen upstream modules and experiment records are checked by SHA-256.
