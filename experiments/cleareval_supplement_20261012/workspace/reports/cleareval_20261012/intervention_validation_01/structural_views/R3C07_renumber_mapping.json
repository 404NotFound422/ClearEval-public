  "nodes": [
    {
      "label": "101",
      "punctuation": "",
      "start": 624,
      "end": 658,
      "label_start": 626,
      "label_end": 629,
      "body_start": 630,
      "body": "样品预处理（Post-fixation wash）**\n",
      "source_quote": "**101 样品预处理（Post-fixation wash）**\n",
      "node_id": "N0001",
      "parent_id": null
    },
    {
      "label": "101.1",
      "punctuation": "",
      "start": 658,
      "end": 740,
      "label_start": 658,
      "label_end": 663,
      "body_start": 664,
      "body": "将已4% PFA固定的成年小鼠全脑置于1× PBS中充分漂洗，去除残余固定液。(Temperature: 4 ℃, Time: 3 × 1 hour)\n",
      "source_quote": "101.1 将已4% PFA固定的成年小鼠全脑置于1× PBS中充分漂洗，去除残余固定液。(Temperature: 4 ℃, Time: 3 × 1 hour)\n",
      "node_id": "N0002",
      "parent_id": "N0001"
    },
    {
      "label": "102",
      "punctuation": "",
      "start": 741,
      "end": 761,
      "label_start": 743,
      "label_end": 746,
      "body_start": 747,
      "body": "全脑免疫染色前渗透处理**\n",
      "source_quote": "**102 全脑免疫染色前渗透处理**\n",
      "node_id": "N0003",
      "parent_id": null
    },
    {
      "label": "102.1",
      "punctuation": "",
      "start": 761,
      "end": 856,
      "label_start": 761,
      "label_end": 766,
      "body_start": 767,
      "body": "将脑组织置于含0.2% (vol/vol) Triton X-100的1× PBS（PBST）中振荡渗透。(Temperature: 37 ℃, Time: 24 hours)\n",
      "source_quote": "102.1 将脑组织置于含0.2% (vol/vol) Triton X-100的1× PBS（PBST）中振荡渗透。(Temperature: 37 ℃, Time: 24 hours)\n",
      "node_id": "N0004",
      "parent_id": "N0003"
    },
    {
      "label": "102.2",
      "punctuation": "",
      "start": 856,
      "end": 911,
      "label_start": 856,
      "label_end": 861,
      "body_start": 862,
      "body": "更换新鲜PBST继续渗透。(Temperature: 37 ℃, Time: 24 hours)\n",
      "source_quote": "102.2 更换新鲜PBST继续渗透。(Temperature: 37 ℃, Time: 24 hours)\n",
      "node_id": "N0005",
      "parent_id": "N0003"
    },
    {
      "label": "103",
      "punctuation": "",
      "start": 912,
      "end": 923,
      "label_start": 914,
      "label_end": 917,
      "body_start": 918,
      "body": "封闭**\n",
      "source_quote": "**103 封闭**\n",
      "node_id": "N0006",
      "parent_id": null
    },
    {
      "label": "103.1",
      "punctuation": "",
      "start": 923,
      "end": 1051,
      "label_start": 923,
      "label_end": 928,
      "body_start": 929,
      "body": "将脑组织置于封闭液（5% (vol/vol) 正常驴血清 + 0.2% Triton X-100 + 0.1% (wt/vol) NaN₃ in 1× PBS）中振荡封闭。(Temperature: 37 ℃, Time: 24 hours)\n",
      "source_quote": "103.1 将脑组织置于封闭液（5% (vol/vol) 正常驴血清 + 0.2% Triton X-100 + 0.1% (wt/vol) NaN₃ in 1× PBS）中振荡封闭。(Temperature: 37 ℃, Time: 24 hours)\n",
      "node_id": "N0007",
      "parent_id": "N0006"
    },
    {
      "label": "104",
      "punctuation": "",
      "start": 1052,
      "end": 1087,
      "label_start": 1054,
      "label_end": 1057,
      "body_start": 1058,
      "body": "一抗孵育（β-III Tubulin / TUJ1）**\n",
      "source_quote": "**104 一抗孵育（β-III Tubulin / TUJ1）**\n",
      "node_id": "N0008",
      "parent_id": null
    },
    {
      "label": "104.1",
      "punctuation": "",
      "start": 1087,
      "end": 1187,
      "label_start": 1087,
      "label_end": 1092,
      "body_start": 1093,
      "body": "将脑组织置于含抗β-III Tubulin（TUJ1）兔多克隆抗体（1:500稀释于封闭液）的溶液中，轻柔振荡孵育。(Temperature: 37 ℃, Time: 48 hours)\n",
      "source_quote": "104.1 将脑组织置于含抗β-III Tubulin（TUJ1）兔多克隆抗体（1:500稀释于封闭液）的溶液中，轻柔振荡孵育。(Temperature: 37 ℃, Time: 48 hours)\n",
      "node_id": "N0009",
      "parent_id": "N0008"
    },
    {
      "label": "104.2",
      "punctuation": "",
      "start": 1187,
      "end": 1245,
      "label_start": 1187,
      "label_end": 1192,
      "body_start": 1193,
      "body": "用PBST洗涤，去除未结合一抗。(Temperature: RT, Time: 5 × 1 hour)\n",
      "source_quote": "104.2 用PBST洗涤，去除未结合一抗。(Temperature: RT, Time: 5 × 1 hour)\n",
      "node_id": "N0010",
      "parent_id": "N0008"
    },
    {
      "label": "105",
      "punctuation": "",
      "start": 1246,
      "end": 1276,
      "label_start": 1248,
      "label_end": 1251,
      "body_start": 1252,
      "body": "二抗孵育（Alexa Fluor 647）**\n",
      "source_quote": "**105 二抗孵育（Alexa Fluor 647）**\n",
      "node_id": "N0011",
      "parent_id": null
    },
    {
      "label": "105.1",
      "punctuation": "",
      "start": 1276,
      "end": 1371,
      "label_start": 1276,
      "label_end": 1281,
      "body_start": 1282,
      "body": "将脑组织置于含驴抗兔 Alexa Fluor 647二抗（1:500稀释于封闭液）的溶液中，避光振荡孵育。(Temperature: 37 ℃, Time: 48 hours)\n",
      "source_quote": "105.1 将脑组织置于含驴抗兔 Alexa Fluor 647二抗（1:500稀释于封闭液）的溶液中，避光振荡孵育。(Temperature: 37 ℃, Time: 48 hours)\n",
      "node_id": "N0012",
      "parent_id": "N0011"
    },
    {
      "label": "105.2",
      "punctuation": "",
      "start": 1371,
      "end": 1429,
      "label_start": 1371,
      "label_end": 1376,
      "body_start": 1377,
      "body": "用PBST洗涤，去除未结合二抗。(Temperature: RT, Time: 5 × 1 hour)\n",
      "source_quote": "105.2 用PBST洗涤，去除未结合二抗。(Temperature: RT, Time: 5 × 1 hour)\n",
      "node_id": "N0013",
      "parent_id": "N0011"
    },
    {
      "label": "105.3",
      "punctuation": "",
      "start": 1429,
      "end": 1481,
      "label_start": 1429,
      "label_end": 1434,
      "body_start": 1435,
      "body": "用1× PBS终洗。(Temperature: RT, Time: 2 × 30 min)\n",
      "source_quote": "105.3 用1× PBS终洗。(Temperature: RT, Time: 2 × 30 min)\n",
      "node_id": "N0014",
      "parent_id": "N0011"
    },
    {
      "label": "106",
      "punctuation": "",
      "start": 1482,
      "end": 1502,
      "label_start": 1484,
      "label_end": 1487,
      "body_start": 1488,
      "body": "脱水（THF梯度脱水）**\n",
      "source_quote": "**106 脱水（THF梯度脱水）**\n",
      "node_id": "N0015",
      "parent_id": null
    },
    {
      "label": "106.1",
      "punctuation": "",
      "start": 1502,
      "end": 1602,
      "label_start": 1502,
      "label_end": 1507,
      "body_start": 1508,
      "body": "将脑组织置于50% (vol/vol) THF（四氢呋喃）水溶液（用NaOH调pH至9–10，以保护荧光蛋白）中振荡脱水。(Temperature: 4 ℃, Time: 1 hour)\n",
      "source_quote": "106.1 将脑组织置于50% (vol/vol) THF（四氢呋喃）水溶液（用NaOH调pH至9–10，以保护荧光蛋白）中振荡脱水。(Temperature: 4 ℃, Time: 1 hour)\n",
      "node_id": "N0016",
      "parent_id": "N0015"
    },
    {
      "label": "106.2",
      "punctuation": "",
      "start": 1602,
      "end": 1682,
      "label_start": 1602,
      "label_end": 1607,
      "body_start": 1608,
      "body": "将脑组织置于70% (vol/vol) THF水溶液（pH 9–10）中振荡脱水。(Temperature: 4 ℃, Time: 1 hour)\n",
      "source_quote": "106.2 将脑组织置于70% (vol/vol) THF水溶液（pH 9–10）中振荡脱水。(Temperature: 4 ℃, Time: 1 hour)\n",
      "node_id": "N0017",
      "parent_id": "N0015"
    },
    {
      "label": "106.3",
      "punctuation": "",
      "start": 1682,
      "end": 1762,
      "label_start": 1682,
      "label_end": 1687,
      "body_start": 1688,
      "body": "将脑组织置于80% (vol/vol) THF水溶液（pH 9–10）中振荡脱水。(Temperature: 4 ℃, Time: 1 hour)\n",
      "source_quote": "106.3 将脑组织置于80% (vol/vol) THF水溶液（pH 9–10）中振荡脱水。(Temperature: 4 ℃, Time: 1 hour)\n",
      "node_id": "N0018",
      "parent_id": "N0015"
    },
    {
      "label": "106.4",
      "punctuation": "",
      "start": 1762,
      "end": 1845,
      "label_start": 1762,
      "label_end": 1767,
      "body_start": 1768,
      "body": "将脑组织置于100% THF（无水，pH 9–10，加少量NaOH）中振荡脱水，第一次。(Temperature: 4 ℃, Time: 1 hour)\n",
      "source_quote": "106.4 将脑组织置于100% THF（无水，pH 9–10，加少量NaOH）中振荡脱水，第一次。(Temperature: 4 ℃, Time: 1 hour)\n",
      "node_id": "N0019",
      "parent_id": "N0015"
    },
    {
      "label": "106.5",
      "punctuation": "",
      "start": 1845,
      "end": 1929,
      "label_start": 1845,
      "label_end": 1850,
      "body_start": 1851,
      "body": "将脑组织置于100% THF（无水，pH 9–10）中振荡脱水，第二次（更换新鲜THF）。(Temperature: 4 ℃, Time: 1 hour)\n",
      "source_quote": "106.5 将脑组织置于100% THF（无水，pH 9–10）中振荡脱水，第二次（更换新鲜THF）。(Temperature: 4 ℃, Time: 1 hour)\n",
      "node_id": "N0020",
      "parent_id": "N0015"
    },
    {
      "label": "107",
      "punctuation": "",
      "start": 1930,
      "end": 1950,
      "label_start": 1932,
      "label_end": 1935,
      "body_start": 1936,
      "body": "脱脂（BABB预处理）**\n",
      "source_quote": "**107 脱脂（BABB预处理）**\n",
      "node_id": "N0021",
      "parent_id": null
    },
    {
      "label": "107.1",
      "punctuation": "",
      "start": 1950,
      "end": 2063,
      "label_start": 1950,
      "label_end": 1955,
      "body_start": 1956,
      "body": "将脑组织置于BABB（苯甲醇:苯甲酸苄酯 = 1:2, vol/vol）中振荡，完成脱脂并开始RI匹配，直至组织完全透明（通常30–60 min）。(Temperature: 4 ℃, Time: 1 hour)\n",
      "source_quote": "107.1 将脑组织置于BABB（苯甲醇:苯甲酸苄酯 = 1:2, vol/vol）中振荡，完成脱脂并开始RI匹配，直至组织完全透明（通常30–60 min）。(Temperature: 4 ℃, Time: 1 hour)\n",
      "node_id": "N0022",
      "parent_id": "N0021"
    },
    {
      "label": "108",
      "punctuation": "",
      "start": 2064,
      "end": 2091,
      "label_start": 2066,
      "label_end": 2069,
      "body_start": 2070,
      "body": "折射率匹配（RI Matching）**\n",
      "source_quote": "**108 折射率匹配（RI Matching）**\n",
      "node_id": "N0023",
      "parent_id": null
    },
    {
      "label": "108.1",
      "punctuation": "",
      "start": 2091,
      "end": 2179,
      "label_start": 2091,
      "label_end": 2096,
      "body_start": 2097,
      "body": "将透明脑组织转移至新鲜BABB（RI ≈ 1.56）中，避光静置平衡，确保组织完全透明且无气泡。(Temperature: 4 ℃, Time: 2 hours)\n",
      "source_quote": "108.1 将透明脑组织转移至新鲜BABB（RI ≈ 1.56）中，避光静置平衡，确保组织完全透明且无气泡。(Temperature: 4 ℃, Time: 2 hours)\n",
      "node_id": "N0024",
      "parent_id": "N0023"
    },
    {
      "label": "108.2",
      "punctuation": "",
      "start": 2179,
      "end": 2243,
      "label_start": 2179,
      "label_end": 2184,
      "body_start": 2185,
      "body": "再次更换新鲜BABB，确认组织完全透明，准备成像。(Temperature: 4 ℃, Time: 30 min)\n",
      "source_quote": "108.2 再次更换新鲜BABB，确认组织完全透明，准备成像。(Temperature: 4 ℃, Time: 30 min)\n",
      "node_id": "N0025",
      "parent_id": "N0023"
    },
    {
      "label": "109",
      "punctuation": "",
      "start": 2244,
      "end": 2261,
      "label_start": 2246,
      "label_end": 2249,
      "body_start": 2250,
      "body": "成像前处理与保存**\n",
      "source_quote": "**109 成像前处理与保存**\n",
      "node_id": "N0026",
      "parent_id": null
    },
    {
      "label": "109.1",
      "punctuation": "",
      "start": 2261,
      "end": 2358,
      "label_start": 2261,
      "label_end": 2266,
      "body_start": 2267,
      "body": "将透明脑组织转移至适配光片显微镜样品槽的BABB中，使用折射率匹配的浸没介质（RI = 1.56）固定样品位置，避免气泡。(Temperature: RT, Time: 即刻成像)\n",
      "source_quote": "109.1 将透明脑组织转移至适配光片显微镜样品槽的BABB中，使用折射率匹配的浸没介质（RI = 1.56）固定样品位置，避免气泡。(Temperature: RT, Time: 即刻成像)\n",
      "node_id": "N0027",
      "parent_id": "N0026"
    },
    {
      "label": "109.2",
      "punctuation": "",
      "start": 2358,
      "end": 2446,
      "label_start": 2358,
      "label_end": 2363,
      "body_start": 2364,
      "body": "若需短期保存，将样品密封于BABB中，避光、4 ℃保存（建议1周内完成成像，以防荧光信号衰减）。(Temperature: 4 ℃, Time: ≤ 7 days)",
      "source_quote": "109.2 若需短期保存，将样品密封于BABB中，避光、4 ℃保存（建议1周内完成成像，以防荧光信号衰减）。(Temperature: 4 ℃, Time: ≤ 7 days)",
      "node_id": "N0028",
      "parent_id": "N0026"
    }
