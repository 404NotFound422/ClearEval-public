  "nodes": [
    {
      "label": "1",
      "punctuation": "",
      "start": 624,
      "end": 656,
      "label_start": 626,
      "label_end": 627,
      "body_start": 628,
      "body": "样品预处理（Post-fixation wash）**\n",
      "source_quote": "**1 样品预处理（Post-fixation wash）**\n",
      "node_id": "N0001",
      "parent_id": null
    },
    {
      "label": "1.1",
      "punctuation": "",
      "start": 656,
      "end": 736,
      "label_start": 656,
      "label_end": 659,
      "body_start": 660,
      "body": "将已4% PFA固定的成年小鼠全脑置于1× PBS中充分漂洗，去除残余固定液。(Temperature: 4 ℃, Time: 3 × 1 hour)\n",
      "source_quote": "1.1 将已4% PFA固定的成年小鼠全脑置于1× PBS中充分漂洗，去除残余固定液。(Temperature: 4 ℃, Time: 3 × 1 hour)\n",
      "node_id": "N0002",
      "parent_id": "N0001"
    },
    {
      "label": "2",
      "punctuation": "",
      "start": 737,
      "end": 755,
      "label_start": 739,
      "label_end": 740,
      "body_start": 741,
      "body": "全脑免疫染色前渗透处理**\n",
      "source_quote": "**2 全脑免疫染色前渗透处理**\n",
      "node_id": "N0003",
      "parent_id": null
    },
    {
      "label": "2.1",
      "punctuation": "",
      "start": 755,
      "end": 848,
      "label_start": 755,
      "label_end": 758,
      "body_start": 759,
      "body": "将脑组织置于含0.2% (vol/vol) Triton X-100的1× PBS（PBST）中振荡渗透。(Temperature: 37 ℃, Time: 24 hours)\n",
      "source_quote": "2.1 将脑组织置于含0.2% (vol/vol) Triton X-100的1× PBS（PBST）中振荡渗透。(Temperature: 37 ℃, Time: 24 hours)\n",
      "node_id": "N0004",
      "parent_id": "N0003"
    },
    {
      "label": "2.2",
      "punctuation": "",
      "start": 848,
      "end": 901,
      "label_start": 848,
      "label_end": 851,
      "body_start": 852,
      "body": "更换新鲜PBST继续渗透。(Temperature: 37 ℃, Time: 24 hours)\n",
      "source_quote": "2.2 更换新鲜PBST继续渗透。(Temperature: 37 ℃, Time: 24 hours)\n",
      "node_id": "N0005",
      "parent_id": "N0003"
    },
    {
      "label": "3",
      "punctuation": "",
      "start": 902,
      "end": 911,
      "label_start": 904,
      "label_end": 905,
      "body_start": 906,
      "body": "封闭**\n",
      "source_quote": "**3 封闭**\n",
      "node_id": "N0006",
      "parent_id": null
    },
    {
      "label": "3.1",
      "punctuation": "",
      "start": 911,
      "end": 1037,
      "label_start": 911,
      "label_end": 914,
      "body_start": 915,
      "body": "将脑组织置于封闭液（5% (vol/vol) 正常驴血清 + 0.2% Triton X-100 + 0.1% (wt/vol) NaN₃ in 1× PBS）中振荡封闭。(Temperature: 37 ℃, Time: 24 hours)\n",
      "source_quote": "3.1 将脑组织置于封闭液（5% (vol/vol) 正常驴血清 + 0.2% Triton X-100 + 0.1% (wt/vol) NaN₃ in 1× PBS）中振荡封闭。(Temperature: 37 ℃, Time: 24 hours)\n",
      "node_id": "N0007",
      "parent_id": "N0006"
    },
    {
      "label": "4",
      "punctuation": "",
      "start": 1038,
      "end": 1071,
      "label_start": 1040,
      "label_end": 1041,
      "body_start": 1042,
      "body": "一抗孵育（β-III Tubulin / TUJ1）**\n",
      "source_quote": "**4 一抗孵育（β-III Tubulin / TUJ1）**\n",
      "node_id": "N0008",
      "parent_id": null
    },
    {
      "label": "4.1",
      "punctuation": "",
      "start": 1071,
      "end": 1169,
      "label_start": 1071,
      "label_end": 1074,
      "body_start": 1075,
      "body": "将脑组织置于含抗β-III Tubulin（TUJ1）兔多克隆抗体（1:500稀释于封闭液）的溶液中，轻柔振荡孵育。(Temperature: 37 ℃, Time: 48 hours)\n",
      "source_quote": "4.1 将脑组织置于含抗β-III Tubulin（TUJ1）兔多克隆抗体（1:500稀释于封闭液）的溶液中，轻柔振荡孵育。(Temperature: 37 ℃, Time: 48 hours)\n",
      "node_id": "N0009",
      "parent_id": "N0008"
    },
    {
      "label": "4.2",
      "punctuation": "",
      "start": 1169,
      "end": 1225,
      "label_start": 1169,
      "label_end": 1172,
      "body_start": 1173,
      "body": "用PBST洗涤，去除未结合一抗。(Temperature: RT, Time: 5 × 1 hour)\n",
      "source_quote": "4.2 用PBST洗涤，去除未结合一抗。(Temperature: RT, Time: 5 × 1 hour)\n",
      "node_id": "N0010",
      "parent_id": "N0008"
    },
    {
      "label": "5",
      "punctuation": "",
      "start": 1226,
      "end": 1254,
      "label_start": 1228,
      "label_end": 1229,
      "body_start": 1230,
      "body": "二抗孵育（Alexa Fluor 647）**\n",
      "source_quote": "**5 二抗孵育（Alexa Fluor 647）**\n",
      "node_id": "N0011",
      "parent_id": null
    },
    {
      "label": "5.1",
      "punctuation": "",
      "start": 1254,
      "end": 1347,
      "label_start": 1254,
      "label_end": 1257,
      "body_start": 1258,
      "body": "将脑组织置于含驴抗兔 Alexa Fluor 647二抗（1:500稀释于封闭液）的溶液中，避光振荡孵育。(Temperature: 37 ℃, Time: 48 hours)\n",
      "source_quote": "5.1 将脑组织置于含驴抗兔 Alexa Fluor 647二抗（1:500稀释于封闭液）的溶液中，避光振荡孵育。(Temperature: 37 ℃, Time: 48 hours)\n",
      "node_id": "N0012",
      "parent_id": "N0011"
    },
    {
      "label": "5.2",
      "punctuation": "",
      "start": 1347,
      "end": 1403,
      "label_start": 1347,
      "label_end": 1350,
      "body_start": 1351,
      "body": "用PBST洗涤，去除未结合二抗。(Temperature: RT, Time: 5 × 1 hour)\n",
      "source_quote": "5.2 用PBST洗涤，去除未结合二抗。(Temperature: RT, Time: 5 × 1 hour)\n",
      "node_id": "N0013",
      "parent_id": "N0011"
    },
    {
      "label": "5.3",
      "punctuation": "",
      "start": 1403,
      "end": 1453,
      "label_start": 1403,
      "label_end": 1406,
      "body_start": 1407,
      "body": "用1× PBS终洗。(Temperature: RT, Time: 2 × 30 min)\n",
      "source_quote": "5.3 用1× PBS终洗。(Temperature: RT, Time: 2 × 30 min)\n",
      "node_id": "N0014",
      "parent_id": "N0011"
    },
    {
      "label": "6",
      "punctuation": "",
      "start": 1454,
      "end": 1472,
      "label_start": 1456,
      "label_end": 1457,
      "body_start": 1458,
      "body": "脱水（THF梯度脱水）**\n",
      "source_quote": "**6 脱水（THF梯度脱水）**\n",
      "node_id": "N0015",
      "parent_id": null
    },
    {
      "label": "6.1",
      "punctuation": "",
      "start": 1472,
      "end": 1570,
      "label_start": 1472,
      "label_end": 1475,
      "body_start": 1476,
      "body": "将脑组织置于50% (vol/vol) THF（四氢呋喃）水溶液（用NaOH调pH至9–10，以保护荧光蛋白）中振荡脱水。(Temperature: 4 ℃, Time: 1 hour)\n",
      "source_quote": "6.1 将脑组织置于50% (vol/vol) THF（四氢呋喃）水溶液（用NaOH调pH至9–10，以保护荧光蛋白）中振荡脱水。(Temperature: 4 ℃, Time: 1 hour)\n",
      "node_id": "N0016",
      "parent_id": "N0015"
    },
    {
      "label": "6.2",
      "punctuation": "",
      "start": 1570,
      "end": 1648,
      "label_start": 1570,
      "label_end": 1573,
      "body_start": 1574,
      "body": "将脑组织置于70% (vol/vol) THF水溶液（pH 9–10）中振荡脱水。(Temperature: 4 ℃, Time: 1 hour)\n",
      "source_quote": "6.2 将脑组织置于70% (vol/vol) THF水溶液（pH 9–10）中振荡脱水。(Temperature: 4 ℃, Time: 1 hour)\n",
      "node_id": "N0017",
      "parent_id": "N0015"
    },
    {
      "label": "6.3",
      "punctuation": "",
      "start": 1648,
      "end": 1726,
      "label_start": 1648,
      "label_end": 1651,
      "body_start": 1652,
      "body": "将脑组织置于80% (vol/vol) THF水溶液（pH 9–10）中振荡脱水。(Temperature: 4 ℃, Time: 1 hour)\n",
      "source_quote": "6.3 将脑组织置于80% (vol/vol) THF水溶液（pH 9–10）中振荡脱水。(Temperature: 4 ℃, Time: 1 hour)\n",
      "node_id": "N0018",
      "parent_id": "N0015"
    },
    {
      "label": "6.4",
      "punctuation": "",
      "start": 1726,
      "end": 1807,
      "label_start": 1726,
      "label_end": 1729,
      "body_start": 1730,
      "body": "将脑组织置于100% THF（无水，pH 9–10，加少量NaOH）中振荡脱水，第一次。(Temperature: 4 ℃, Time: 1 hour)\n",
      "source_quote": "6.4 将脑组织置于100% THF（无水，pH 9–10，加少量NaOH）中振荡脱水，第一次。(Temperature: 4 ℃, Time: 1 hour)\n",
      "node_id": "N0019",
      "parent_id": "N0015"
    },
    {
      "label": "6.5",
      "punctuation": "",
      "start": 1807,
      "end": 1889,
      "label_start": 1807,
      "label_end": 1810,
      "body_start": 1811,
      "body": "将脑组织置于100% THF（无水，pH 9–10）中振荡脱水，第二次（更换新鲜THF）。(Temperature: 4 ℃, Time: 1 hour)\n",
      "source_quote": "6.5 将脑组织置于100% THF（无水，pH 9–10）中振荡脱水，第二次（更换新鲜THF）。(Temperature: 4 ℃, Time: 1 hour)\n",
      "node_id": "N0020",
      "parent_id": "N0015"
    },
    {
      "label": "7",
      "punctuation": "",
      "start": 1890,
      "end": 1908,
      "label_start": 1892,
      "label_end": 1893,
      "body_start": 1894,
      "body": "脱脂（BABB预处理）**\n",
      "source_quote": "**7 脱脂（BABB预处理）**\n",
      "node_id": "N0021",
      "parent_id": null
    },
    {
      "label": "7.1",
      "punctuation": "",
      "start": 1908,
      "end": 2019,
      "label_start": 1908,
      "label_end": 1911,
      "body_start": 1912,
      "body": "将脑组织置于BABB（苯甲醇:苯甲酸苄酯 = 1:2, vol/vol）中振荡，完成脱脂并开始RI匹配，直至组织完全透明（通常30–60 min）。(Temperature: 4 ℃, Time: 1 hour)\n",
      "source_quote": "7.1 将脑组织置于BABB（苯甲醇:苯甲酸苄酯 = 1:2, vol/vol）中振荡，完成脱脂并开始RI匹配，直至组织完全透明（通常30–60 min）。(Temperature: 4 ℃, Time: 1 hour)\n",
      "node_id": "N0022",
      "parent_id": "N0021"
    },
    {
      "label": "8",
      "punctuation": "",
      "start": 2020,
      "end": 2045,
      "label_start": 2022,
      "label_end": 2023,
      "body_start": 2024,
      "body": "折射率匹配（RI Matching）**\n",
      "source_quote": "**8 折射率匹配（RI Matching）**\n",
      "node_id": "N0023",
      "parent_id": null
    },
    {
      "label": "8.1",
      "punctuation": "",
      "start": 2045,
      "end": 2131,
      "label_start": 2045,
      "label_end": 2048,
      "body_start": 2049,
      "body": "将透明脑组织转移至新鲜BABB（RI ≈ 1.56）中，避光静置平衡，确保组织完全透明且无气泡。(Temperature: 4 ℃, Time: 2 hours)\n",
      "source_quote": "8.1 将透明脑组织转移至新鲜BABB（RI ≈ 1.56）中，避光静置平衡，确保组织完全透明且无气泡。(Temperature: 4 ℃, Time: 2 hours)\n",
      "node_id": "N0024",
      "parent_id": "N0023"
    },
    {
      "label": "8.2",
      "punctuation": "",
      "start": 2131,
      "end": 2193,
      "label_start": 2131,
      "label_end": 2134,
      "body_start": 2135,
      "body": "再次更换新鲜BABB，确认组织完全透明，准备成像。(Temperature: 4 ℃, Time: 30 min)\n",
      "source_quote": "8.2 再次更换新鲜BABB，确认组织完全透明，准备成像。(Temperature: 4 ℃, Time: 30 min)\n",
      "node_id": "N0025",
      "parent_id": "N0023"
    },
    {
      "label": "9",
      "punctuation": "",
      "start": 2194,
      "end": 2209,
      "label_start": 2196,
      "label_end": 2197,
      "body_start": 2198,
      "body": "成像前处理与保存**\n",
      "source_quote": "**9 成像前处理与保存**\n",
      "node_id": "N0026",
      "parent_id": null
    },
    {
      "label": "9.1",
      "punctuation": "",
      "start": 2209,
      "end": 2304,
      "label_start": 2209,
      "label_end": 2212,
      "body_start": 2213,
      "body": "将透明脑组织转移至适配光片显微镜样品槽的BABB中，使用折射率匹配的浸没介质（RI = 1.56）固定样品位置，避免气泡。(Temperature: RT, Time: 即刻成像)\n",
      "source_quote": "9.1 将透明脑组织转移至适配光片显微镜样品槽的BABB中，使用折射率匹配的浸没介质（RI = 1.56）固定样品位置，避免气泡。(Temperature: RT, Time: 即刻成像)\n",
      "node_id": "N0027",
      "parent_id": "N0026"
    },
    {
      "label": "9.2",
      "punctuation": "",
      "start": 2304,
      "end": 2390,
      "label_start": 2304,
      "label_end": 2307,
      "body_start": 2308,
      "body": "若需短期保存，将样品密封于BABB中，避光、4 ℃保存（建议1周内完成成像，以防荧光信号衰减）。(Temperature: 4 ℃, Time: ≤ 7 days)",
      "source_quote": "9.2 若需短期保存，将样品密封于BABB中，避光、4 ℃保存（建议1周内完成成像，以防荧光信号衰减）。(Temperature: 4 ℃, Time: ≤ 7 days)",
      "node_id": "N0028",
      "parent_id": "N0026"
    }
  ],
