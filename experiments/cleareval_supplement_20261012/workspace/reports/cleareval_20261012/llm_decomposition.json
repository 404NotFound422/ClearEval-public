      "other_claims": [
        {
          "source": {
            "line": 3,
            "start": 87,
            "end": 677,
            "quote": "**Justification:** iDISCO+ is well-suited for clearing thick brain tissue blocks (up to 3 mm) while preserving weak endogenous fluorescent signals like GFP. It uses organic solvents that are compatible with lipid-soluble dyes and allows for long-term storage in refractive index-matched media. The combination of endogenous GFP and a secondary antibody labeling with Alexa Fluor 647 provides dual-color imaging, enabling clear visualization of sparse neuronal structures (e.g., dendrites) and their spatial relationships in 3D. MAP2 labeling enhances the resolution of dendritic morphology."
          },
          "interpretation": "3D is a spatial expression, not a duration"
        },
        {
          "source": {
            "line": 30,
            "start": 2024,
            "end": 2122,
            "quote": "5.1 Incubation with fresh RI-matching solution (1.48) (Temperature: 4 ℃, Time: 1 week or longer)  "
          },
          "interpretation": "storage lower bound one week, no finite upper bound"
        },
        {
          "source": {
            "line": 31,
            "start": 2123,
            "end": 2293,
            "quote": "5.2 Imaging using light-sheet or confocal microscopy with appropriate excitation/emission settings for GFP (488 nm / 509–549 nm) and Alexa Fluor 647 (633 nm / 650–700 nm)"
          },
          "interpretation": "imaging procedure without a reported duration"
        }
